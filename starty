#!/bin/sh
# starty — bring up yserver on a free display, run a session, tear down.
#
# The installed counterpart of the `just startx` recipe. Mirrors real
# `startx`: scan for the lowest free X display, mint a per-session
# MIT-MAGIC-COOKIE-1, hand it to yserver via -auth (an unguessable mktemp
# /tmp file, the SERVER's copy — used only to validate incoming clients),
# add the same cookie to the user's ~/.Xauthority keyed to :$display, run
# the session with XAUTHORITY pointed at ~/.Xauthority, and on exit remove
# the :$display entry + delete the temp server file. Needs xauth on PATH;
# the cookie comes from mcookie, or /dev/urandom where there is none.
#
# Usage:
#   starty                 # run ~/.xinitrc (/etc/X11/xinit/xinitrc fallback)
#   starty bspwm           # run a WM/client resolved via PATH (no xinitrc)
#   starty bspwm --foo bar # ...with client args
#   starty -- --vrr        # ...with server args
#
# Runs STANDALONE from a bare TTY (yserver drives KMS directly, no seat
# manager): refuses pty / SSH / graphical-terminal callers via a console
# check on stdin. Your user needs /dev/dri + /dev/input access (see
# docs/setup.md): `sudo usermod -aG video,input $USER` then re-login.
#
# Portable across the shells and platforms yserver supports (dash, bash,
# BusyBox ash; Linux, FreeBSD and OpenBSD) rather than strictly POSIX —
# it relies on mktemp, [ -S ] and trap EXIT, which are universal in
# practice.
#
# Console takeover (which stops the kernel from turning Ctrl-C in an X
# client into a signal that kills the session) is implemented on Linux,
# FreeBSD and OpenBSD virtual consoles.

set -eu

usage() {
    cat <<'EOF'
usage: starty [client [client_args...]] [-- server_args...]

  With no client, runs ~/.xinitrc (or /etc/X11/xinit/xinitrc fallback).
  With a client, resolves it via PATH and runs it with the given args.
  Arguments after -- are passed to yserver.

Example:
  starty -- --vrr

Environment:
  RUST_LOG   yserver log level (default: warn)
  XAUTHORITY alternate user authority file (default: ~/.Xauthority)

Logs:
  server   $XDG_STATE_HOME/yserver/yserver.log  (~/.local/state/yserver/...)
  session  $XDG_STATE_HOME/yserver/session.log
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0;;
esac

# --- TTY guard: yserver needs a real controlling console. ---------------
case "$(tty 2>/dev/null || true)" in
    /dev/tty[0-9]*) ;;      # Linux virtual console
    /dev/ttyv[0-9a-f]*) ;;  # FreeBSD vt(4) console (ttyv0..ttyvf)
    /dev/ttyC[0-9a-f]*) ;;  # OpenBSD wscons console (ttyC0..)
    *) got=$(tty 2>/dev/null || true)
       [ -n "$got" ] || got='no controlling tty'
       echo "starty: must be run from a TTY (got: $got)" >&2
       echo "       switch to a free VT (Linux: Ctrl-Alt-F2) and run starty there." >&2
       exit 1;;
esac

# --- Resolve the client command (or fall back to xinitrc). --------------
have_client=0
client_bin=""
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
    have_client=1
    client_bin=$(command -v "$1" 2>/dev/null) || {
        echo "starty: client not found: $1" >&2; exit 127; }
    shift
else
    xinitrc="${XINITRC:-$HOME/.xinitrc}"
    [ -f "$xinitrc" ] || xinitrc=/etc/X11/xinit/xinitrc
    [ -f "$xinitrc" ] || { echo "starty: no ~/.xinitrc and no /etc/X11/xinit/xinitrc" >&2; exit 1; }
fi

# --- Depends: xauth is part of the auth handshake. ----------------------
command -v xauth  >/dev/null 2>&1 || { echo "starty: xauth not found on PATH (try: pacman -S xorg-xauth)" >&2; exit 1; }
command -v yserver >/dev/null 2>&1 || { echo "starty: yserver not found on PATH (run: just install)" >&2; exit 1; }

# --- State + logs. -------------------------------------------------------
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/yserver"
mkdir -p "$state_dir"
server_log="$state_dir/yserver.log"
session_log="$state_dir/session.log"

# --- Pick the lowest free display. --------------------------------------
display=0
while [ -e /tmp/.X11-unix/X$display ]; do display=$((display+1)); done

# Every command is `|| :`-guarded: under `set -e` a single failure (a
# server that already exited makes `kill` fail; `wait` reports the SIGTERM
# status) would abort the handler and leak the cookie entry and temp file.
# Guarded on emptiness too, because the trap is armed before the server
# starts.
cleanup() {
    [ -z "${yserver_pid:-}" ] || kill -TERM "$yserver_pid" 2>/dev/null || :
    [ -z "${yserver_pid:-}" ] || wait "$yserver_pid" 2>/dev/null || :
    [ -z "${userauth:-}" ] || xauth -f "$userauth" remove ":$display" 2>/dev/null || :
    [ -z "${authfile:-}" ] || rm -f "$authfile" || :
}

authfile=$(mktemp /tmp/yserver-startx-auth.XXXXXX)
userauth="${XAUTHORITY:-$HOME/.Xauthority}"
# Armed here, not after the server launch: a failing `xauth add` below
# would otherwise leak the temp file and a half-written authority entry.
trap cleanup EXIT INT TERM
# 128 random bits as 32 hex digits. OpenBSD has no mcookie (util-linux).
if command -v mcookie >/dev/null 2>&1; then
    cookie=$(mcookie)
else
    cookie=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
fi
xauth -f "$authfile"  add ":$display" . "$cookie"
xauth -f "$userauth"  add ":$display" . "$cookie"
echo "starty: DISPLAY=:$display (server auth $authfile; cookie added to $userauth)"

# --- Bring up the server. -----------------------------------------------
# Inherit the TTY login's XDG_RUNTIME_DIR — a real VT has the real
# /run/user/UID + systemd --user instance, which is what makes agent/UI/keyring reached from ~/.xinitrc work.
launch_yserver() {
    # Consume client arguments through the first separator; only the tail is
    # appended to yserver. With no separator the tail is empty.
    while [ "$#" -gt 0 ]; do
        if [ "$1" = "--" ]; then
            shift
            break
        fi
        shift
    done
    RUST_LOG="${RUST_LOG:-warn}" RUST_BACKTRACE=1 \
        yserver "$display" -auth "$authfile" "$@" >"$server_log" 2>&1 &
    yserver_pid=$!
}
launch_yserver "$@"

# Wait for the socket (cap at ~30 s like the recipe).
waited=0
while [ "$waited" -lt 30 ]; do
    [ -S /tmp/.X11-unix/X$display ] && break
    sleep 1
    waited=$((waited + 1))
    if ! kill -0 "$yserver_pid" 2>/dev/null; then
        echo "starty: yserver exited before the socket came up — see $server_log" >&2
        exit 1
    fi
done
[ -S /tmp/.X11-unix/X$display ] || { echo "starty: socket not ready — see $server_log" >&2; exit 1; }

# --- Run the session. ---------------------------------------------------
# Belt-and-braces: a real VT wouldn't have WAYLAND_* set anyway. Exporting
# into this shell is safe — cleanup() passes xauth an explicit -f and
# display, and reads neither variable.
unset WAYLAND_DISPLAY WAYLAND_SOCKET
export XDG_SESSION_TYPE=x11
export XAUTHORITY="$userauth"
export DISPLAY=":$display"
run_client() {
    session_bin=$1
    shift
    # Keep the arguments before the first "--"; the rest went to yserver.
    remaining=$#
    seen_separator=0
    while [ "$remaining" -gt 0 ]; do
        arg=$1
        shift
        remaining=$((remaining - 1))
        [ "$arg" = "--" ] && seen_separator=1
        [ "$seen_separator" -eq 1 ] || set -- "$@" "$arg"
    done
    "$session_bin" "$@" >"$session_log" 2>&1
}
if [ "$have_client" -eq 1 ]; then
    run_client "$client_bin" "$@"
else
    sh "$xinitrc" >"$session_log" 2>&1
fi
